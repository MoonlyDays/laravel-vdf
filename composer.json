{
    "name": "moonlydays/laravel-vdf",
    "description": "Valve's VDF / KeyValues text format for Laravel.",
    "license": "MIT",
    "homepage": "https://github.com/MoonlyDays/laravel-vdf",
    "authors": [
        {
            "name": "Daniil Basiuc-Brinzei",
            "email": "contact@moonlydays.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "MoonlyDays\\LaravelVdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "pint --parallel",
            "rector"
        ],
        "test": "pest"
    },
    "extra": {
        "laravel": {
            "aliases": {
                "Vdf": "MoonlyDays\\LaravelVdf\\Facades\\Vdf"
            },
            "providers": [
                "MoonlyDays\\LaravelVdf\\VdfServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/pint": "^1.32.3",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-rector": "^5.0",
        "rector/rector": "^2.8"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
